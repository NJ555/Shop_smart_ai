# ShopSmart AI Backend Configuration
# Copy this file to .env and supply your local secrets.

PORT=4000
DB_PATH=../db/shopsmart.db
JWT_SECRET=replace-with-a-secure-random-jwt-secret-string
JWT_EXPIRES_IN=1800
FRONTEND_ORIGIN=http://localhost:3000
REFUND_APPROVAL_THRESHOLD=100

# Live AI / DeepSeek Model Configuration (OpenAI-compatible)
# Option A: Direct DeepSeek API
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# Option B: TokenHarbor Gateway (deepseek-v4.1-flash:free)
TOKENHARBOR_API_KEY=your_tokenharbor_api_key_here
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free

